# Copy to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email (Gmail) ---
# Use the SMTP backend to actually deliver mail. Swap for
# django.core.mail.backends.console.EmailBackend to print to the terminal instead.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Gmail requires a 16-character App Password here, not your account password:
# https://myaccount.google.com/apppasswords (2FA must be enabled)
EMAIL_HOST_USER=your.address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
# Port 587 uses STARTTLS. For port 465 use EMAIL_USE_TLS=False and EMAIL_USE_SSL=True.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=E-Shop <your.address@gmail.com>
